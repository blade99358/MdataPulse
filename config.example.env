# MDataPulse settings. Copy to ~/.zabbix_env (chmod 600), fill in, then: source ~/.zabbix_env
# Never commit the real file.

# Zabbix API
export ZABBIX_URL=http://localhost:80          # where the Zabbix web UI answers on the server
export ZABBIX_TOKEN=                           # Users > API tokens
export ZABBIX_WEB_URL=                         # the Zabbix URL as users' browsers reach it (links in reports)
# export ZABBIX_INSECURE=1                     # accept a self-signed certificate

# Your network
export RCA_TZ=UTC                              # time zone for reports and day boundaries
export SITE_CODE_PREFIX=SITE                   # site codes look like SITE0001
export CORE_SITE=SITE0000                      # where the network starts
export DISASTER_SITES=SITE0000                 # sites whose Site DOWN alarm is a Disaster (comma separated)
export DISCOVERY_RANGES=                       # e.g. 10.20.0.0/22,10.20.10.0/24
export DISCOVERY_UPS_RANGE=                    # e.g. 10.20.10.0/24
export MDP_DATA_DIR=                           # private data files (default: data/ in the checkout)

# Reports web service (rca_server.py)
export RCA_PORT=8081
export RCA_BIND=0.0.0.0
export REPORT_DIR=/var/lib/mdp-reports
export REPORT_EXCLUDE='^EP-'                   # hosts left out of the health reports (endpoint CPEs)
export MDP_OWNER=                              # shown in the footer: "Created by ..."
export MDP_CLIENT=                             # optional: "... for the <client>"
export MDP_OWNER_LOGO=                         # optional image file for the footer

# Radio signal check
export SIGNAL_TIME=15:00
export SIGNAL_LACP=                            # regex of radio host names on LACP links (not measured)
export SIGNAL_LACP_NOTE=

# Database reads (zbxdb.py): peer auth as the postgres user by default
# export PGHOST= PGPORT=5432 PGDATABASE=zabbix PGUSER=zabbix PGPASSWORD=

# WhatsApp alarms: settings live in /etc/whatsapp-relay.conf (WAHA_API_KEY, WA_CHAT_ID, RELAY_TOKEN).
